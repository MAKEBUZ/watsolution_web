            <stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Set USER_TOKEN property" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def token = vars.get("DYN_USER_TOKEN")
if (token != null &amp;&amp; token != "TOKEN_NOT_FOUND") {
    props.put("USER_TOKEN", token)
    log.info("USER_TOKEN set: " + token.substring(0,20) + "...")
} else {
    log.warn("User login failed - static token will be used")
}</stringProp>
          </JSR223PostProcessor>
