          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract user token" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">DYN_USER_TOKEN</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.id_token</stringProp>
