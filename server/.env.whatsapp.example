# Copia estas variables al .env del servidor o a sus variables de entorno.
# Este archivo es una plantilla y no se carga automáticamente. Nunca pongas secretos aquí.
WHATSAPP_ENABLED=false
# Copia la versión de la URL graph.facebook.com/vXX.0 que muestra el ejemplo de Meta.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Secreto propio aleatorio de al menos 32 caracteres; no es el access token de Meta.
WHATSAPP_VERIFY_TOKEN=
# Tu número verificado en Meta: código de país y número, solo dígitos (máximo 5).
WHATSAPP_TEST_RECIPIENTS=
# Asistente con vinculación de cuenta; aplicar primero la migración WhatsappAccounts.
# false conserva la respuesta fija y la lista de destinatarios de prueba anterior.
WHATSAPP_ASSISTANT_ENABLED=false
# Número público del negocio, con país y solo dígitos, para el enlace de vinculación.
WHATSAPP_BUSINESS_PHONE=
# Los avisos requieren además consentimiento y las tres plantillas UTILITY aprobadas en Meta.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_CREATED=watsolution_factura_disponible_v1
WHATSAPP_TEMPLATE_DUE=watsolution_factura_por_vencer_v1
WHATSAPP_TEMPLATE_PAID=watsolution_pago_confirmado_v1
